        border-radius: 2px;
        margin-left: -2px;
        margin-right: -2px;
      }
      .user-mention[href$="/int-index"]:before,
      .user-mention[href$="/int-index"]:after {
        content: '';
        display: inline-block;
        width: 2px;
      }
    </style>


